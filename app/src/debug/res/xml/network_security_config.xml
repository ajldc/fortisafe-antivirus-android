<?xml version="1.0" encoding="utf-8"?>
<!--
  Só no build de debug (substitui o de src/main): HTTP em claro liberado SÓ para
  10.0.2.2 (o Mac visto do emulador) e localhost, para o teste de ponta a ponta
  sem servidor (protocolo v1 das bases, seção 8: python3 -m http.server e
  -Pfortisafe.bases.url=http://10.0.2.2:8080/v1/). Todo o resto continua só
  HTTPS. O release usa src/main/res/xml/network_security_config.xml, sem HTTP em
  claro. Vale da API 24 em diante; nas APIs 21 a 23 a guarda é o código
  (GuardaUrl), que aceita os mesmos dois hosts e só no debug.
  ⚠️ Com targetSdk >= 37, falar com endereço da rede local exigirá a permissão
  ACCESS_LOCAL_NETWORK (só para este teste; o release não usa a LAN).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
