<?xml version="1.0" encoding="utf-8"?>
<!--
  Detalhe de uma detecção (entrega 1.5): evidência sempre visível antes de
  qualquer ação (condição C2 da matriz, seção REQUEST_DELETE_PACKAGES), aviso de
  que a assinatura conhecida pode errar, "Contestar" e a consulta ao VirusTotal,
  que só existe aqui (D-AV17). "Ignorar" tem o mesmo tamanho da ação principal.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raizDetalhe"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fortisafe_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/FortiSafe.Cabecalho"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:text="@string/app_name" />

        <LinearLayout
            android:id="@+id/faixaDetalhe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_faixa_risco"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtDetalheTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDetalheTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            style="@style/FortiSafe.Secao"
            android:text="@string/detalhe_evidencia" />

        <LinearLayout
            android:id="@+id/listaEvidencia"
            style="@style/FortiSafe.Cartao"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtDetalheAviso"
            style="@style/FortiSafe.Corpo"
            android:layout_marginTop="12dp"
            android:text="@string/detalhe_aviso_falso_positivo" />

        <TextView
            android:id="@+id/txtDetalheSituacao"
            style="@style/FortiSafe.Corpo"
            android:layout_marginTop="12dp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDetalhePrincipal"
                style="@style/FortiSafe.Botao.Perigo"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:layout_marginRight="6dp" />

            <Button
                android:id="@+id/btnDetalheIgnorar"
                style="@style/FortiSafe.Botao.Secundario"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginLeft="6dp"
                android:text="@string/ignoreDetection" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnDetalheVirusTotal"
            style="@style/FortiSafe.Link"
            android:layout_marginTop="8dp"
            android:text="@string/detalhe_virustotal" />

        <TextView
            android:id="@+id/btnDetalheContestar"
            style="@style/FortiSafe.Link"
            android:text="@string/detalhe_contestar" />
    </LinearLayout>
</ScrollView>
