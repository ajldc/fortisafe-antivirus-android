<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+: nada do FortiSafe Antivírus sai por backup na nuvem nem por
  transferência entre aparelhos (G0, B23). Bases, preferências e histórico
  ficam só no aparelho; um aparelho novo baixa as bases de novo.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
